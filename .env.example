# Safe defaults: moderation works without Docker or an AI provider.
GROUPGUARD_AGENT_ENABLED=false
GROUPGUARD_ENFORCEMENT_ENABLED=false
GROUPGUARD_AGENT_PROJECT_WRITE_ENABLED=false
GROUPGUARD_MIN_OBSERVATION_HOURS=24
GROUPGUARD_ALLOW_REGEX_FILTERS=false
GROUPGUARD_TYPING_INDICATOR_ENABLED=false
GROUPGUARD_PUBLIC_PLAYGROUND_ENABLED=false

# Conservative product budgets. These are not published WhatsApp limits.
GROUPGUARD_MAX_OUTBOUND_MESSAGES_PER_MINUTE=8
GROUPGUARD_MAX_MODERATION_ACTIONS_PER_MINUTE=12
GROUPGUARD_MAX_MODERATION_DMS_PER_HOUR=6
GROUPGUARD_SAFETY_FAILURE_THRESHOLD=3
GROUPGUARD_SAFETY_CIRCUIT_COOLDOWN_MS=900000
GROUPGUARD_WHATSAPP_ACTION_TIMEOUT_MS=15000

# Reconnect slowly and stop after a bounded number of failures.
GROUPGUARD_RECONNECT_MAX_ATTEMPTS=8
GROUPGUARD_RECONNECT_BASE_DELAY_MS=1000
GROUPGUARD_RECONNECT_MAX_DELAY_MS=60000

ASSISTANT_NAME=GroupGuard
LOG_LEVEL=info

# Optional agent credentials. Leave blank while agent mode is disabled.
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
