WHATSAPP_ENABLED=true
# Use digits only. This is read locally and must never be committed in .env.
WHATSAPP_PHONE_NUMBER=

# GroupGuard fails closed if this file is missing or invalid.
GROUPGUARD_CONFIG_PATH=config/groupguard.json

# Optional second allowlist. If present, a group must be in both this list and
# config/groupguard.json. Comma-separate WhatsApp group JIDs.
GROUPGUARD_ALLOWED_GROUPS=

# Keep false through the observation period. The enforcement command updates it.
GROUPGUARD_ENFORCEMENT_ENABLED=false

GROUPGUARD_RECONNECT_MAX_ATTEMPTS=8
GROUPGUARD_RECONNECT_BASE_DELAY_MS=1000
GROUPGUARD_RECONNECT_MAX_DELAY_MS=60000
